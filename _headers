# 静态资源缓存头（Cloudflare Pages 的 _headers 文件）
# 图片长缓存，HTML 短缓存
/wp-content/uploads/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000

/*.js
  Cache-Control: public, max-age=31536000

/*
  Cache-Control: public, max-age=3600
